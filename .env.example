# Copier ce fichier vers `.env` (jamais commité — voir .gitignore) avant `docker-compose up`.
# Ne sert QUE pour l'exécution via Docker Compose ; en local hors Docker, la même clé
# vient de `dotnet user-secrets set "Jwt:Key" "..."` (voir InventorySystem.Api.csproj).

# Clé de signature JWT (HMAC-SHA256) — au moins 32 caractères aléatoires.
# Générer par ex. avec : openssl rand -base64 48
JWT_KEY=

# Mot de passe de la base PostgreSQL (Docker Compose) et de pgAdmin.
# Générer par ex. avec : openssl rand -base64 24
POSTGRES_PASSWORD=
PGADMIN_PASSWORD=

# Port PostgreSQL publie sur la machine hote. 5432 est souvent deja occupe par un
# autre projet : le deplacer ici evite d arreter l un pour lancer l autre.
# Le port interne au reseau Docker reste 5432 dans tous les cas.
POSTGRES_PORT=5433
