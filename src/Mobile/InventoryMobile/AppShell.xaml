<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="InventoryMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:InventoryMobile.Views"
    Title="InventoryMobile"
    FlyoutBehavior="Disabled">

    <!-- ShellContent racine (navigation absolue //login / //products) ; Flyout désactivé. -->
    <ShellContent
        Title="Connexion"
        FlyoutItemIsVisible="False"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="login" />

    <ShellContent
        Title="Produits"
        FlyoutItemIsVisible="False"
        ContentTemplate="{DataTemplate views:ProductsPage}"
        Route="products" />

</Shell>
