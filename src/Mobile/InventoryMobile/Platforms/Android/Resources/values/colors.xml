<!-- Couleurs natives. colorPrimary teinte la barre d'état derrière la barre de titre des pages
     poussées : elle prend le fond de page (Colors.xaml) pour ne pas former un bandeau.
     colorAccent, le bleu de marque du web, colore les contrôles natifs (curseurs, dialogues). -->
<resources>
    <color name="colorPrimary">#F8FAFC</color>
    <color name="colorPrimaryDark">#F8FAFC</color>
    <color name="colorAccent">#184E77</color>
</resources>
