<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Jetons de couleur, repris du front web (src/Frontend/src/index.css et Layout.css) :
    neutres ardoise de Tailwind, bleu de marque #184e77 comme unique accent, rose pour le stock
    bas, ambre pour une baisse qui n'est pas une erreur. Le mode sombre reprend les valeurs de la
    classe .dark du web (fond #0f172a, surfaces #1e293b, accent texte #99d98c).
    Voir aussi Platforms/Android/Resources/values*/colors.xml pour les couleurs natives.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette de marque du web (couleurs brand du thème). -->
    <Color x:Key="Brand900">#184E77</Color>
    <Color x:Key="Brand700">#1A759F</Color>
    <Color x:Key="Brand500">#34A0A4</Color>
    <Color x:Key="Brand300">#99D98C</Color>

    <!-- Fonds et surfaces -->
    <Color x:Key="PageLight">#F8FAFC</Color>
    <Color x:Key="PageDark">#0F172A</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1E293B</Color>
    <Color x:Key="SurfaceSunkenLight">#F1F5F9</Color>
    <Color x:Key="SurfaceSunkenDark">#0F172A</Color>
    <Color x:Key="TrackLight">#E2E8F0</Color>
    <Color x:Key="TrackDark">#334155</Color>

    <!-- Filets -->
    <Color x:Key="LineLight">#E2E8F0</Color>
    <Color x:Key="LineDark">#334155</Color>
    <Color x:Key="LineStrongLight">#CBD5E1</Color>
    <Color x:Key="LineStrongDark">#475569</Color>

    <!-- Texte : slate-900, slate-700, slate-600 (4,5:1 minimum sur fond blanc comme sur #1e293b). -->
    <Color x:Key="InkLight">#0F172A</Color>
    <Color x:Key="InkDark">#F1F5F9</Color>
    <Color x:Key="InkSoftLight">#334155</Color>
    <Color x:Key="InkSoftDark">#E2E8F0</Color>
    <Color x:Key="MutedLight">#475569</Color>
    <Color x:Key="MutedDark">#CBD5E1</Color>

    <!-- Accent : boutons pleins en brand-900 dans les deux thèmes, comme le web ; en sombre, les
         textes d'accent (liens, onglet actif) passent au vert clair de la marque. -->
    <Color x:Key="AccentLight">#184E77</Color>
    <Color x:Key="AccentDark">#184E77</Color>
    <Color x:Key="AccentInkLight">#184E77</Color>
    <Color x:Key="AccentInkDark">#99D98C</Color>
    <Color x:Key="AccentSoftLight">#E8EDF1</Color>
    <Color x:Key="AccentSoftDark">#2D3E45</Color>
    <Color x:Key="OnAccent">#FFFFFF</Color>
    <!-- Barres de répartition : brand-700 (4,7:1 contre la piste), brand-500 en sombre. -->
    <Color x:Key="BarLight">#1A759F</Color>
    <Color x:Key="BarDark">#34A0A4</Color>
    <!-- Libellé de rôle (#0f6b6f sur blanc : 6,4:1). -->
    <Color x:Key="RoleLight">#0F6B6F</Color>
    <Color x:Key="RoleDark">#99D98C</Color>

    <!-- Stock bas, sorties, erreurs : rose-700/800 sur rose-50/100. -->
    <Color x:Key="DangerLight">#BE123C</Color>
    <Color x:Key="DangerDark">#FDA4AF</Color>
    <Color x:Key="DangerInkLight">#9F1239</Color>
    <Color x:Key="DangerInkDark">#FECDD3</Color>
    <Color x:Key="DangerSoftLight">#FFE4E6</Color>
    <Color x:Key="DangerSoftDark">#4C1D2B</Color>
    <Color x:Key="DangerLineLight">#FECDD3</Color>
    <Color x:Key="DangerLineDark">#881337</Color>

    <!-- Baisse sans gravité (variation du flux), stock proche du seuil : ambre-700/900. -->
    <Color x:Key="WarningLight">#B45309</Color>
    <Color x:Key="WarningDark">#FBBF24</Color>
    <Color x:Key="WarningInkLight">#78350F</Color>
    <Color x:Key="WarningInkDark">#FDE68A</Color>
    <Color x:Key="WarningSoftLight">#FEF3C7</Color>
    <Color x:Key="WarningSoftDark">#422006</Color>

</ResourceDictionary>
